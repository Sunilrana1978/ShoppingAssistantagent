{
  "displayName": "profanity_blocklist",
  "description": "Blocks basic profanity in user input.",
  "enabled": true,
  "contentFilter": {
    "bannedContentsInUserInput": [
      "fuck",
      "shit",
      "asshole",
      "bitch",
      "bastard",
      "cunt",
      "damn",
      "hell",
      "crap",
      "piss"
    ],
    "matchType": "WORD_BOUNDARY_STRING_MATCH"
  },
  "action": {
    "respondImmediately": {
      "responses": [
        { "text": "Let's keep our conversation respectful. How can I help you with sporting goods today?" }
      ]
    }
  }
}
