{
  "name": "ShoppingAssistantApp",
  "displayName": "Sporting Goods Multi-Agent Shopping & Feedback App",
  "description": "Multi-agent conversational application with Root Router, Shopping Assistant, and Customer Feedback Agent.",
  "rootAgent": "RootAgent",
  "loggingSettings": {
    "cloudLoggingSettings": {
      "enableCloudLogging": true
    },
    "conversationLoggingSettings": {
      "disableConversationLogging": false,
      "retentionWindow": "31536000s"
    },
    "bigqueryExportSettings": {
      "enabled": true,
      "project": "ecom-cx-agent",
      "dataset": "shopping_assistant_logs"
    },
    "redactionConfig": {
      "enableRedaction": true
    }
  },
  "variableDeclarations": [
    {
      "name": "retry_count",
      "description": "Tracks tool execution retry loops within a single session",
      "schema": {
        "type": "NUMBER"
      }
    },
    {
      "name": "active_intent",
      "description": "Active user intent detected by RootAgent.",
      "schema": {
        "type": "STRING"
      }
    },
    {
      "name": "cart",
      "description": "Current cart state containing items, subtotal, discount_amount, and total.",
      "schema": {
        "type": "OBJECT",
        "properties": {
          "items": {
            "type": "ARRAY",
            "items": {
              "type": "OBJECT",
              "properties": {
                "sku": {
                  "type": "STRING"
                },
                "name": {
                  "type": "STRING"
                },
                "qty": {
                  "type": "INTEGER"
                },
                "size": {
                  "type": "STRING"
                },
                "unit_price": {
                  "type": "NUMBER"
                }
              }
            }
          },
          "subtotal": {
            "type": "NUMBER"
          },
          "discount_pct": {
            "type": "NUMBER"
          },
          "discount_amount": {
            "type": "NUMBER"
          },
          "total": {
            "type": "NUMBER"
          }
        }
      }
    },
    {
      "name": "comments",
      "description": "Customer feedback comments.",
      "schema": {
        "type": "STRING"
      }
    },
    {
      "name": "discount_pct",
      "description": "Active discount percentage.",
      "schema": {
        "type": "NUMBER"
      }
    },
    {
      "name": "feedback_submitted",
      "description": "Flag indicating feedback submission status.",
      "schema": {
        "type": "BOOLEAN",
        "default": false
      }
    },
    {
      "name": "membership_tier",
      "description": "User membership tier (none, bronze, silver, gold).",
      "schema": {
        "type": "STRING"
      }
    },
    {
      "name": "rating",
      "description": "Star rating from 1 to 5.",
      "schema": {
        "type": "NUMBER"
      }
    },
    {
      "name": "search_results",
      "description": "List of matching product objects from catalog search.",
      "schema": {
        "type": "ARRAY",
        "items": {
          "type": "OBJECT"
        }
      }
    },
    {
      "name": "session_id",
      "description": "Unique session identifier.",
      "schema": {
        "type": "STRING"
      }
    },
    {
      "name": "user_id",
      "description": "Unique user identifier from channel payload.",
      "schema": {
        "type": "STRING"
      }
    },
    {
      "name": "user_name",
      "description": "User display name.",
      "schema": {
        "type": "STRING"
      }
    },
    {
      "name": "long_term_memories",
      "description": "Recalled long-term memory facts from Vertex AI Memory Bank for the current user.",
      "schema": {
        "type": "ARRAY",
        "items": {
          "type": "STRING"
        }
      }
    }
  ],
  "guardrails": [
    "prompt_guard",
    "competitor_blocklist",
    "hallucination_safety_filter"
  ],
  "timeZoneSettings": {
    "timeZone": "America/Los_Angeles"
  }
}